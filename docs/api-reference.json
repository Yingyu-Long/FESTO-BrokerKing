    "/incidents/{logId}": {
      "get": {
        "tags": [
          "Incidents"
        ],
        "summary": "Provides the incident with the given log id.",
        "description": "This endpoint supports an optional HTTP header 'SMRTNC-LANGUAGE'.\nThe 'SMRTNC-LANGUAGE' header is used to specify the language for the response.\nExpected values are supported language codes: 'de', 'en', 'en-gb', 'es', 'fr', 'cs', 'hu', 'it', 'ja', 'ko', 'pl', 'pt', 'ro', 'ru', 'sr', 'tr', 'zh'.\nIf the header is provided, some properties of the custom field such as 'label', 'description' and 'options' will be translated in that language\nIf the header is not provided or there is no translation in that language, the custom field will be returned in the default language",
        "parameters": [
          {
            "name": "logId",
            "in": "path",
            "description": "The id of the log.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "version",
