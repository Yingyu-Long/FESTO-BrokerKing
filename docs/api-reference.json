    "/incidents": {
      "get": {
        "tags": [
          "Incidents"
        ],
        "summary": "Provides the incident logs for a machine. Use the optional query parameter to filter the response.",
        "description": "Provides the incident logs for a machine. Use the optional query parameter to filter the response.",
        "parameters": [
          {
            "name": "machineId",
            "in": "query",
            "description": "Machine id for which the incidents are requested. (Mandatory)",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Filters the response to values ​​`from` the given datetime. (Optional)",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Filters the response to values ​​up `to` the given datetime. (Optional)",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "The offset to start the list (Optional, default value: 0)",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "The limit of entries in the list (Optional, default value: 10, max: 1000)",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
